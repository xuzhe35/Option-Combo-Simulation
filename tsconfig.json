{
  // Type-checks the opted-in plain scripts in place. Nothing is emitted: the
  // pages keep loading js/*.js directly. A file joins by being listed below
  // and carrying `// @ts-check`; tests/type_check.test.js runs this project.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    // No "dom": the listed modules are DOM-free and the checker keeps them so.
    "lib": ["es2022"],
    "types": []
  },
  "files": [
    "types/globals.d.ts",
    "js/pricing_core.js",
    "js/cost_basis_fop_core.js"
  ]
}
